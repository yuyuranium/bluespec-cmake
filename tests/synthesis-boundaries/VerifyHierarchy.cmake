file(READ "${ARTIFACT_DIR}/mkTop.v" _top)
if(NOT _top MATCHES "mkChild[ \n]+value")
  message(FATAL_ERROR "The synthesized child was inlined into the top module")
endif()
file(STRINGS "${ARTIFACT_DIR}/rtl.f" _rtl_files)
set(_found FALSE)
foreach(_file IN LISTS _rtl_files)
  if(_file MATCHES "/mkChild\\.v$")
    if(NOT EXISTS "${_file}")
      message(FATAL_ERROR "Missing child RTL: ${_file}")
    endif()
    set(_found TRUE)
  endif()
endforeach()
if(NOT _found)
  message(FATAL_ERROR "The synthesized child's RTL is missing from the filelist")
endif()
